# Environment configuration template for Backend API
ENVIRONMENT=development
DEBUG=true

# Database & Cache
DATABASE_URL=postgresql+asyncpg://autose_user:autose_password@localhost:5432/autose_platform
REDIS_URL=redis://localhost:6379/0

# JWT & Webhook Security
JWT_SECRET_KEY=change-this-to-a-secure-32-character-random-key
GITHUB_WEBHOOK_SECRET=change-this-to-a-secure-webhook-secret
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# AI Provider API Keys
AI_PROVIDER=gemini
GOOGLE_API_KEY=your_google_api_key
MODEL_NAME=gemini-1.5-flash
GROQ_API_KEY=gsk_your_groq_api_key
OPENAI_API_KEY=sk_your_openai_api_key
OLLAMA_BASE_URL=http://localhost:11434
